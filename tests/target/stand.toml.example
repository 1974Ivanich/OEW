# Описание стенда HWT (DDTT-6.3). Этот файл — шаблон: скопируйте его в
# tests/target/stand.local.toml (этот путь в .gitignore) и подставьте свои
# значения. Описание стенда не публикуется вместе с проектом, если содержит
# сведения о конкретном оборудовании (DDTT-6.3-1).

[probe]
# Ожидаемая идентичность цели. Сверяется ДО первого чтения памяти
# (DDTT-6.4-3): несовпадение = ERROR, а не «попробуем и посмотрим».
# Диапазон по умолчанию оставлен пустым: заполните после первого `hwt doctor`.
device_id = 0x000
flash_size_kb = 0
# policy: "deny" — отказ при несовпадении; "warn" — предупреждение.
policy = "deny"

[server]
# OpenOCD: конфиг интерфейса и цели. По умолчанию — openocd.cfg в корне.
openocd_cfg = "openocd.cfg"
gdb_port = 3333
# Требовать исключительный доступ к адаптеру (DDTT-6.6-1).
exclusive = true

[run]
# reset-halt — сброс и остановка перед каждым сценарием (детерминированно,
# DDTT-6.2-5); attach — только остановка, без сброса (не сбивает текущий опыт).
state = "reset-halt"

[safety]
# Инъекции (запись значений, принудительный возврат) по умолчанию запрещены:
# инъекция в силовой схеме может привести к опасному поведению (DDTT §8).
allow_injections = false
