#!/bin/sh
# pre-push hook — опциональный самоконтроль периферии CubeMX.
#
# По умолчанию НЕ активен: hook срабатывает только если включён явно:
#     git config hooks.cubemx-check true
# Отключить обратно:
#     git config hooks.cubemx-check false
#
# Проверка запускается только при изменении OEW_Motor.ioc (конфигурация
# периферии). Правки в .c/.h без .ioc — не повод гонять CubeMX 3 минуты:
# это ловит `make` и CI.
#
# Коды cubemx_check.py: 0 = PASS, 1 = расхождение (блокируем push),
# 2 = ошибка прогона (нет CubeMX/.ioc, таймаут) — предупреждаем, не блокируем.

if [ "$(git config --get hooks.cubemx-check 2>/dev/null)" != "true" ]; then
    exit 0
fi

BASE=$(git rev-parse --verify upstream/main 2>/dev/null) || \
BASE=$(git rev-parse --verify origin/main 2>/dev/null) || exit 0

CHANGED=$(git diff --name-only "$BASE"...HEAD 2>/dev/null | grep -E '\.ioc$' || true)
if [ -z "$CHANGED" ]; then
    exit 0
fi

echo "[hook] Изменён OEW_Motor.ioc — сверка периферии с CubeMX (~3 мин)..."
timeout 360 python scripts/cubemx_check.py
RC=$?
if [ $RC -eq 1 ]; then
    echo "[hook] CubeMX: РАСХОЖДЕНИЯ. Push отклонён (hooks.cubemx-check false — отключить)."
    exit 1
fi
if [ $RC -eq 2 ]; then
    echo "[hook] CubeMX: ошибка прогона (нет CubeMX/.ioc). Push пропущен."
    exit 0
fi
echo "[hook] CubeMX: сверка пройдена"
exit 0